# --- LLM API Keys (Set the ones you use) ---
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Model Selection (LiteLLM Format: provider/model) ---
ARGUS_LLM_MODEL=gemini/gemini-2.5-flash
ARGUS_PRO_MODEL=gemini/gemini-2.5-pro
USE_LOBSTER_TRAP_BINARY=true
# LOBSTER_TRAP_BINARY_PATH=./lobster-trap/lobstertrap
# LOBSTER_TRAP_POLICY_PATH=./configs/lobstertrap_policy.yaml
DATABASE_URL=sqlite+aiosqlite:///./argus.db
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
INTENT_LATENCY_TARGET_MS=300
